FROM golang:1.23-alpine AS builder
WORKDIR /app
# We only copy go.mod first because go.sum will be generated by go mod download if missing
COPY go.mod ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -o bpa-calculator main.go

FROM alpine:3.19
WORKDIR /app
COPY --from=builder /app/bpa-calculator .
EXPOSE 8080
HEALTHCHECK --interval=30s CMD wget -qO- http://localhost:8080/health || exit 1
CMD ["./bpa-calculator"]
